# Core
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://aiqg:change-me@postgres:5432/aiqg
FRONTEND_ORIGIN=http://localhost:3000
STORAGE_DIR=/app/storage
MAX_UPLOAD_MB=25
ALLOW_REGISTRATION=true
COOKIE_NAME=aiqg_session
COOKIE_SECURE=false
SESSION_TTL_HOURS=24
CSRF_HEADER_NAME=X-CSRF-Token

# AI provider: mock | openai_compatible | local_openai_compatible
# Use mock only for deterministic local development/tests. Production refuses to start with mock.
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=5000
LLM_TEMPERATURE=0.2
AI_CALLS_PER_MINUTE=20

# OCR. Requires Tesseract installed in the backend runtime.
ENABLE_OCR=false
OCR_LANGUAGE=eng

# Admin seed
SEED_ADMIN_EMAIL=admin@example.edu
SEED_ADMIN_PASSWORD=replace-with-a-long-random-password

# Frontend reverse proxy target. In Docker use http://backend:8000.
BACKEND_INTERNAL_URL=http://backend:8000
